    </characteristic>
    
    <!--Signature Clear-->
    <characteristic const="false" id="signature_clear" name="Signature Clear" sourceId="custom.type" uuid="aa5b69db-821f-448d-aa3e-7d9e53f21fB7">
      <informativeText/>
      <value length="1" type="hex" variable_length="false">00</value>
      <properties>
        <read authenticated="false" bonded="false" encrypted="false"/>
        <write authenticated="false" bonded="false" encrypted="false"/>
      </properties>
