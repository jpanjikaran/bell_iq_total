    </characteristic>
    
    <!--Site Key-->
    <characteristic const="false" id="site_key" name="Site Key" sourceId="custom.type" uuid="aa5b69db-821f-448d-aa3e-7d9e53f21fc3">
      <informativeText/>
      <value length="0" type="hex" variable_length="false">00000000000000000000000000000000</value>
      <properties>
        <read authenticated="false" bonded="false" encrypted="false"/>
        <write authenticated="false" bonded="false" encrypted="false"/>
      </properties>
    </characteristic>
    
    <!--Session Keys-->
    <characteristic const="false" id="session_keys" name="Session Keys" sourceId="custom.type" uuid="aa5b69db-821f-448d-aa3e-7d9e53f21fc1">
