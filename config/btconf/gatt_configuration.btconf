  </service>
  
  <!--Security-->
  <service advertise="false" id="security" name="Security" requirement="mandatory" sourceId="custom.type" type="primary" uuid="aa5b69db-821f-448d-aa3e-7d9e53f21fc0">
    <informativeText/>
    
    <!--Authentication Status-->
    <characteristic const="false" id="authentication_status" name="Authentication Status" sourceId="custom.type" uuid="aa5b69db-821f-448d-aa3e-7d9e53f21fc4">
      <informativeText/>
      <value length="0" type="user" variable_length="false"/>
      <properties>
        <read authenticated="false" bonded="false" encrypted="false"/>
