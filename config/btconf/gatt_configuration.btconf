    <!--sigIndication-->
    <characteristic const="false" id="sig_Indication" name="sigIndication" sourceId="custom.type" uuid="aa5b69db-821f-448d-aa3e-7d9e53f21fB8">
      <informativeText/>
      <value length="0" type="user" variable_length="false"/>
